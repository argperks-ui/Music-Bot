<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Live Logs - Git Music</title>
  <link rel="stylesheet" href="/style.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body>
  <div class="app-layout">
    <aside class="sidebar">
      <div class="sidebar-brand">
        <div class="sidebar-brand-icon"><i class="fa-solid fa-music"></i></div>
        <div class="sidebar-brand-text"><h2>Git Music</h2><span>Dashboard</span></div>
      </div>
      <div class="sidebar-nav">
        <a href="/dashboard" class="nav-item"><i class="fa-solid fa-chart-pie"></i> Overview</a>
        <a href="/guilds" class="nav-item"><i class="fa-solid fa-server"></i> Servers</a>
        <a href="/library" class="nav-item"><i class="fa-solid fa-book-open"></i> Song Library</a>
        <a href="/logs" class="nav-item active"><i class="fa-solid fa-terminal"></i> Live Logs</a>
      </div>
    </aside>
    <main class="main-content">
      <div class="page-header">
        <h1>Live Event Logs</h1>
        <p>Real-time terminal output and music execution logs.</p>
      </div>
      <div class="glass-card">
        <h3><i class="fa-solid fa-terminal" style="color: var(--accent-secondary);"></i> System Terminal</h3>
        <div class="log-feed" id="logFeed">
          <div class="log-entry">
            <span class="log-timestamp">[17:21:00]</span>
            <span class="log-command">BOOT</span>
            <span class="log-guild">Bot initialized successfully. Ready for playback.</span>
          </div>
          <div class="log-entry">
            <span class="log-timestamp">[17:21:14]</span>
            <span class="log-command">READY</span>
            <span class="log-guild">Slash commands synced globally.</span>
          </div>
        </div>
      </div>
    </main>
  </div>
</body>
</html>