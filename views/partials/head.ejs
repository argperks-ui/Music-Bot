<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title ? title + ' · ' : '' %>Git Music Dashboard</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
  <script src="https://cdn.socket.io/4.7.5/socket.io.min.js"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css">
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap');
    * { font-family: 'Inter', system-ui, sans-serif; }
    body { background: #0b0d15; color: #e8edf5; }

    /* Glassmorphism card */
    .glass {
      background: rgba(20, 25, 40, 0.65);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border: 1px solid rgba(255, 255, 255, 0.06);
      box-shadow: 0 8px 32px rgba(0, 0, 0, 0.4);
    }
    .glass-hover:hover {
      background: rgba(25, 32, 50, 0.8);
      border-color: rgba(139, 92, 246, 0.3);
      transition: all 0.2s ease;
    }

    /* Sidebar gradient accent */
    .sidebar-accent {
      background: linear-gradient(135deg, #7c3aed, #06b6d4);
    }
    .sidebar-accent-text {
      background: linear-gradient(135deg, #a78bfa, #67e8f9);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    /* Music equalizer loader */
    .eq-bar {
      width: 4px;
      border-radius: 4px;
      animation: eq 1.2s ease-in-out infinite;
    }
    .eq-bar:nth-child(1) { height: 40%; animation-delay: 0s; background: #7c3aed; }
    .eq-bar:nth-child(2) { height: 80%; animation-delay: 0.15s; background: #8b5cf6; }
    .eq-bar:nth-child(3) { height: 50%; animation-delay: 0.3s; background: #a78bfa; }
    .eq-bar:nth-child(4) { height: 90%; animation-delay: 0.45s; background: #c4b5fd; }
    .eq-bar:nth-child(5) { height: 60%; animation-delay: 0.6s; background: #7c3aed; }
    @keyframes eq {
      0%, 100% { transform: scaleY(1); }
      50% { transform: scaleY(1.8); }
    }

    /* Scrollbar */
    ::-webkit-scrollbar { width: 6px; }
    ::-webkit-scrollbar-track { background: transparent; }
    ::-webkit-scrollbar-thumb { background: rgba(139, 92, 246, 0.4); border-radius: 8px; }
    ::-webkit-scrollbar-thumb:hover { background: rgba(139, 92, 246, 0.6); }

    /* Select / input dark styling */
    select, input, textarea {
      background: rgba(15, 20, 35, 0.8);
      border: 1px solid rgba(255,255,255,0.08);
      color: #e8edf5;
    }
    select:focus, input:focus, textarea:focus {
      border-color: #7c3aed;
      outline: none;
      box-shadow: 0 0 0 2px rgba(124, 58, 237, 0.3);
    }

    /* Stat card pulse */
    .stat-value { font-weight: 800; letter-spacing: -0.02em; }
    .pulse-dot {
      display: inline-block;
      width: 8px; height: 8px;
      border-radius: 50%;
      background: #22c55e;
      animation: pulse 2s infinite;
    }
    @keyframes pulse {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.4; }
    }

    /* Guild icon fallback */
    .guild-icon {
      width: 48px; height: 48px; border-radius: 12px;
      background: linear-gradient(135deg, #7c3aed, #06b6d4);
      display: flex; align-items: center; justify-content: center;
      font-weight: 700; font-size: 1.25rem;
      flex-shrink: 0;
    }

    .btn-primary {
      background: linear-gradient(135deg, #7c3aed, #06b6d4);
      color: #fff; font-weight: 600; padding: 0.5rem 1.25rem;
      border-radius: 10px; border: none; cursor: pointer;
      transition: all 0.2s;
    }
    .btn-primary:hover { transform: translateY(-1px); box-shadow: 0 4px 20px rgba(124, 58, 237, 0.4); }
    .btn-danger {
      background: rgba(239, 68, 68, 0.15);
      color: #ef4444; border: 1px solid rgba(239, 68, 68, 0.25);
      padding: 0.5rem 1.25rem; border-radius: 10px; font-weight: 600; cursor: pointer;
      transition: all 0.2s;
    }
    .btn-danger:hover { background: rgba(239, 68, 68, 0.25); }
  </style>
</head>
<body class="min-h-screen">
  <% if (typeof user !== 'undefined' && user) { %>
  <!-- Sidebar -->
  <aside class="fixed left-0 top-0 h-screen w-64 glass z-50 flex flex-col" style="border-right: 1px solid rgba(255,255,255,0.04);">
    <!-- Logo -->
    <div class="p-5 flex items-center gap-3 border-b border-white/5">
      <div class="flex items-center gap-1 eq-loader" style="height: 24px;">
        <div class="eq-bar"></div><div class="eq-bar"></div><div class="eq-bar"></div><div class="eq-bar"></div><div class="eq-bar"></div>
      </div>
      <span class="text-xl font-extrabold sidebar-accent-text tracking-tight">Git Music</span>
    </div>

    <!-- User info -->
    <div class="px-5 py-3 flex items-center gap-3 border-b border-white/5">
      <img src="https://cdn.discordapp.com/avatars/<%= user.id %>/<%= user.avatar %>.png?size=32"
           alt="" class="w-8 h-8 rounded-full"
           onerror="this.src='https://cdn.discordapp.com/embed/avatars/0.png'">
      <div class="text-sm leading-tight truncate">
        <div class="font-semibold truncate"><%= user.global_name || user.username %></div>
        <div class="text-[#7c8a9a] text-xs">@<%= user.username %></div>
      </div>
    </div>

    <!-- Nav -->
    <nav class="flex-1 px-3 py-4 space-y-1 overflow-y-auto">
      <% const nav = [
        { href: '/dashboard', icon: 'fa-chart-simple', label: 'Overview', id: 'dashboard' },
        { href: '/guilds',     icon: 'fa-server',       label: 'Servers',   id: 'guilds' },
        { href: '/analytics',  icon: 'fa-chart-line',   label: 'Analytics', id: 'analytics' },
        { href: '/logs',       icon: 'fa-list',         label: 'Command Log', id: 'logs' },
      ] %>
      <% nav.forEach(n => { %>
        <a href="<%= n.href %>"
           class="flex items-center gap-3 px-4 py-2.5 rounded-xl text-sm font-medium transition-all
                  <%= active === n.id ? 'bg