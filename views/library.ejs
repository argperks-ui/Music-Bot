<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Song Library - Git Music Cyber Engine</title>
  <link rel="stylesheet" href="/style.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    /* Neon Glassmorphism Overrides */
    body {
      background: #090d16;
      color: #f3f4f6;
      font-family: 'Inter', system-ui, -apple-system, sans-serif;
    }
    .library-toolbar {
      display: flex;
      gap: 16px;
      margin-bottom: 24px;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
    }
    .search-box {
      position: relative;
      flex: 1;
      min-width: 280px;
    }
    .search-box input {
      width: 100%;
      padding: 12px 16px 12px 42px;
      background: rgba(15, 23, 42, 0.8);
      border: 1px solid rgba(139, 92, 246, 0.3);
      border-radius: 12px;
      color: #fff;
      font-size: 14px;
      outline: none;
      transition: all 0.3s ease;
      box-shadow: 0 4px 20px rgba(0,0,0,0.4);
    }
    .search-box input:focus {
      border-color: #06b6d4;
      box-shadow: 0 0 15px rgba(6, 182, 212, 0.4);
    }
    .search-box i {
      position: absolute;
      left: 14px;
      top: 50%;
      transform: translateY(-50%);
      color: #8b5cf6;
    }
    .filter-pills {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
    }
    .pill {
      padding: 8px 16px;
      background: rgba(30, 41, 59, 0.6);
      border: 1px solid rgba(255,255,255,0.08);
      border-radius: 20px;
      font-size: 13px;
      color: #94a3b8;
      cursor: pointer;
      transition: all 0.2s ease;
    }
    .pill:hover, .pill.active {
      background: linear-gradient(135deg, #8b5cf6 0%, #06b6d4 100%);
      color: #fff;
      border-color: transparent;
      box-shadow: 0 0 12px rgba(139, 92, 246, 0.4);
    }
    .track-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      gap: 20px;
      margin-top: 20px;
    }
    .track-card {
      background: rgba(15, 23, 42, 0.65);
      backdrop-filter: blur(12px);
      border: 1px solid rgba(139, 92, 246, 0.15);
      border-radius: 16px;
      padding: 16px;
      position: relative;
      overflow: hidden;
      transition: all 0.3s ease;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }
    .track-card:hover {
      transform: translateY(-5px);
      border-color: rgba(6, 182, 212, 0.5);
      box-shadow: 0 8px 30px rgba(6, 182, 212, 0.15);
    }
    .track-cover {
      width: 100%;
      height: 160px;
      border-radius: 10px;
      object-fit: cover;
      margin-bottom: 12px;
    }
    .track-title {
      font-size: 16px;
      font-weight: 700;
      color: #f8fafc;
      margin: 0 0 4px 0;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .track-artist {
      font-size: 13px;
      color: #a78bfa;
      margin: 0 0 12px 0;
    }
    .track-meta {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-top: auto;
      padding-top: 12px;
      border-top: 1px solid rgba(255, 255, 255, 0.05);
    }
    .genre-badge {
      font-size: 11px;
      padding: 3px 8px;
      border-radius: 6px;
      background: rgba(6, 182, 212, 0.15);
      color: #38bdf8;
      border: 1px solid rgba(56, 189, 248, 0.2);
    }
    .btn-icon {
      width: 36px;
      height: 36px;
      border-radius: 50%;
      background: #8b5cf6;
      border: none;
      color: #fff;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      transition: all 0.2s ease;
      box-shadow: 0 0 10px rgba(139, 92, 246, 0.5);
    }
    .btn-icon:hover {
      background: #06b6d4;
      transform: scale(1.1);
      box-shadow: 0 0 15px rgba(6, 182, 212, 0.7);
    }
    .import-banner {
      background: linear-gradient(135deg, rgba(139, 92, 246, 0.15) 0%, rgba(6, 182, 212, 0.15) 100%);
      border: 1px solid rgba(139, 92, 246, 0.3);
      border-radius: 16px;
      padding: 24px;
      margin-bottom: 28px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 20px;
      flex-wrap: wrap;
    }
  </style>
</head>
<body>
  <div class="app-layout">
    <!-- Sidebar -->
    <aside class="sidebar">
      <div class="sidebar-brand">
        <div class="sidebar-brand-icon"><i class="fa-solid fa-compact-disc fa-spin"></i></div>
        <div class="sidebar-brand-text"><h2>Git Music</h2><span>v2.0 Cyber Engine</span></div>
      </div>
      <div class="sidebar-nav">
        <a href="/dashboard" class="nav-item"><i class="fa-solid fa-chart-pie"></i> Overview</a>
        <a href="/guilds" class="nav-item"><i class="fa-solid fa-server"></i> Servers</a>
        <a href="/library" class="nav-item active"><i class="fa-solid fa-book-open"></i> Song Library</a>
        <a href="/logs" class="nav-item"><i class="fa-solid fa-terminal"></i> Live Logs</a>
      </div>
    </aside>

    <!-- Main Content -->
    <main class="main-content">
      <div class="page-header">
        <h1>Cyber Audio Vault</h1>
        <p>Browse saved presets, search community tracks, or instant-stream to connected voice rooms.</p>
      </div>

      <!-- Quick Import Header -->
      <div class="import-banner">
        <div>
          <h3 style="margin: 0 0 6px 0; color: #06b6d4;"><i class="fa-brands fa-spotify"></i> Import Spotify or YouTube Playlist</h3>
          <p style="margin: 0; color: #94a3b8; font-size: 14px;">Paste any playlist URL to index all tracks directly into your server library.</p>
        </div>
        <div style="display: flex; gap: 10px; width: 100%; max-width: 420px;">
          <input type="text" placeholder="https://open.spotify.com/playlist/..." style="flex: 1; padding: 10px 14px; background: rgba(0,0,0,0.4); border: 1px solid rgba(139,92,246,0.3); border-radius: 8px; color: white;">
          <button class="btn-primary" style="background: linear-gradient(135deg, #8b5cf6, #06b6d4); border: none; white-space: nowrap;"><i class="fa-solid fa-cloud-arrow-down"></i> Sync</button>
        </div>
      </div>

      <!-- Search & Filters -->
      <div class="library-toolbar">
        <div class="search-box">
          <i class="fa-solid fa-magnifying-glass"></i>
          <input type="text" id="trackSearch" onkeyup="filterTracks()" placeholder="Search archive by title, artist, or tag...">
        </div>
        <div class="filter-pills">
          <div class="pill active" onclick="filterGenre('all')">All Tracks</div>
          <div class="pill" onclick="filterGenre('synthwave')">Synthwave</div>
          <div class="pill" onclick="filterGenre('lofi')">Lo-Fi Chill</div>
          <div class="pill" onclick="filterGenre('gaming')">Gaming / EDM</div>
          <div class="pill" onclick="filterGenre('metal')">Rock / Metal</div>
        </div>
      </div>

      <!-- Track Grid -->
      <div class="track-grid" id="trackGrid">
        
        <!-- Track Card 1 -->
        <div class="track-card" data-genre="synthwave">
          <img src="https://images.unsplash.com/photo-1508700115892-45ecd05ae2ad" class="track-cover" alt="Cyber Grid">
          <h4 class="track-title">Cyber City Overdrive</h4>
          <p class="track-artist">Neon Horizon</p>
          <div class="track-meta">
            <span class="genre-badge">Synthwave</span>
            <button class="btn-icon" title="Instant Play in Voice Channel" onclick="quickPlay('Cyber City Overdrive Neon Horizon')"><i class="fa-solid fa-play"></i></button>
          </div>
        </div>

        <!-- Track Card 2 -->
        <div class="track-card" data-genre="lofi">
          <img src="https://images.unsplash.com/photo-1518609878373-06d740f60d8b" class="track-cover" alt="Midnight Study">
          <h4 class="track-title">Midnight Rain & Coffee</h4>
          <p class="track-artist">Lo-Fi Beats Collective</p>
          <div class="track-meta">
            <span class="genre-badge">Lo-Fi Chill</span>
            <button class="btn-icon" title="Instant Play in Voice Channel" onclick="quickPlay('Midnight Rain Coffee Lofi')"><i class="fa-solid fa-play"></i></button>
          </div>
        </div>

        <!-- Track Card 3 -->
        <div class="track-card" data-genre="gaming">
          <img src="https://images.unsplash.com/photo-1542751371-adc38448a05e" class="track-cover" alt="Boss Fight">
          <h4 class="track-title">Final Boss Theme (8-Bit Remix)</h4>
          <p class="track-artist">Pixel Destroyer</p>
          <div class="track-meta">
            <span class="genre-badge">Gaming / EDM</span>
            <button class="btn-icon" title="Instant Play in Voice Channel" onclick="quickPlay('Final Boss Theme 8 Bit Remix')"><i class="fa-solid fa-play"></i></button>
          </div>
        </div>

        <!-- Track Card 4 -->
        <div class="track-card" data-genre="synthwave">
          <img src="https://images.unsplash.com/photo-1514525253161-7a46d19cd819" class="track-cover" alt="Hyperdrive">
          <h4 class="track-title">Retro Hyperdrive 1984</h4>
          <p class="track-artist">Vaporwave Systems</p>
          <div class="track-meta">
            <span class="genre-badge">Synthwave</span>
            <button class="btn-icon" title="Instant Play in Voice Channel" onclick="quickPlay('Retro Hyperdrive 1984 Vaporwave')"><i class="fa-solid fa-play"></i></button>
          </div>
        </div>

        <!-- Track Card 5 -->
        <div class="track-card" data-genre="metal">
          <img src="https://images.unsplash.com/photo-1498038432885-c6f3f1b912ee" class="track-cover" alt="Heavy Riff">
          <h4 class="track-title">Cybernetic Overlord</h4>
          <p class="track-artist">Heavy Metal Engine</p>
          <div class="track-meta">
            <span class="genre-badge">Rock / Metal</span>
            <button class="btn-icon" title="Instant Play in Voice Channel" onclick="quickPlay('Cybernetic Overlord Metal')"><i class="fa-solid fa-play"></i></button>
          </div>
        </div>

      </div>
    </main>
  </div>

  <script>
    function filterTracks() {
      const input = document.getElementById('trackSearch').value.toLowerCase();
      const cards = document.getElementsByClassName('track-card');
      
      Array.from(cards).forEach(card => {
        const title = card.querySelector('.track-title').innerText.toLowerCase();
        const artist = card.querySelector('.track-artist').innerText.toLowerCase();
        if (title.includes(input) || artist.includes(input)) {
          card.style.display = 'flex';
        } else {
          card.style.display = 'none';
        }
      });
    }

    function filterGenre(genre) {
      document.querySelectorAll('.pill').forEach(p => p.classList.remove('active'));
      event.target.classList.add('active');

      const cards = document.getElementsByClassName('track-card');
      Array.from(cards).forEach(card => {
        if (genre === 'all' || card.dataset.genre === genre) {
          card.style.display = 'flex';
        } else {
          card.style.display = 'none';
        }
      });
    }

    async function quickPlay(query) {
      alert('🚀 Sent trigger to Bot Engine for track: ' + query + '\n(Ensure bot is connected to a voice channel!)');
    }
  </script>
</body>
</html>