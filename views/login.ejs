<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Git Music — Dashboard Login</title>
  <link rel="stylesheet" href="/style.css">
  <style>
    .equalizer-hero {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 4px;
      height: 50px;
      margin-bottom: 24px;
    }
    .equalizer-hero span {
      display: block;
      width: 5px;
      background: linear-gradient(180deg, #6C3CE1, #00D4AA);
      border-radius: 3px;
      animation: eqBounce 1.2s ease-in-out infinite alternate;
    }
    .equalizer-hero span:nth-child(1) { height: 30%; animation-delay: 0s; }
    .equalizer-hero span:nth-child(2) { height: 60%; animation-delay: 0.1s; }
    .equalizer-hero span:nth-child(3) { height: 45%; animation-delay: 0.2s; }
    .equalizer-hero span:nth-child(4) { height: 80%; animation-delay: 0.3s; }
    .equalizer-hero span:nth-child(5) { height: 55%; animation-delay: 0.4s; }
    .equalizer-hero span:nth-child(6) { height: 90%; animation-delay: 0.15s; }
    .equalizer-hero span:nth-child(7) { height: 40%; animation-delay: 0.25s; }
    .equalizer-hero span:nth-child(8) { height: 70%; animation-delay: 0.35s; }
    .equalizer-hero span:nth-child(9) { height: 50%; animation-delay: 0.05s; }

    @keyframes eqBounce {
      0% { transform: scaleY(0.4); }
      100% { transform: scaleY(1); }
    }
  </style>
</head>
<body>
  <div class="login-page">
    <div class="login-card glass">
      <div class="equalizer-hero">
        <span></span><span></span><span></span><span></span>
        <span></span><span></span><span></span><span></span><span></span>
      </div>
      <h1>Git Music</h1>
      <p>Bot Control Dashboard</p>
      
      <% if (typeof error !== 'undefined' && error) { %>
        <div class="login-error"><%= error %></div>
      <% } %>
      
      <a href="https://discord.com/api/oauth2/authorize?client_id=<%= clientId %>&redirect_uri=<%= encodeURIComponent(callbackUrl) %>&response_type=code&scope=identify+guilds" class="btn-discord">
        <svg viewBox="0 0 24 24" fill="currentColor">
          <path d="M20.317 4.37a19.791 19.791 0 00-4.885-1.515.074.074 0 00-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 00-5.487 0 12.64 12.64 0 00-.617-1.25.077.077 0 00-.079-.037A19.736 19.736 0 003.677 4.37a.07.07 0 00-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 00.031.057 19.9 19.9 0 005.993 3.03.078.078 0 00.084-.028 14.09 14.09 0 001.226-1.994.076.076 0 00-.041-.106 13.107 13.107 0 01-1.872-.892.077.077 0 01-.008-.128 10.2 10.2 0 00.372-.292.074.074 0 01.077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 01.078.01c.12.098.246.198.373.292a.077.077 0 01-.006.127 12.299 12.299 0 01-1.873.892.077.077 0 00-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 00.084.028 19.839 19.839 0 006.002-3.03.077.077 0 00.032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 00-.031-.03z"/>
        </svg>
        Login with Discord
      </a>
    </div>
  </div>
</body>
</html>