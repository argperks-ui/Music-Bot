<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Servers - Git Music</title>
  <link rel="stylesheet" href="/style.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body>
  <div class="app-layout">
    <aside class="sidebar">
      <div class="sidebar-brand">
        <div class="sidebar-brand-icon"><i class="fa-solid fa-music"></i></div>
        <div class="sidebar-brand-text"><h2>Git Music</h2><span>Dashboard</span></div>
      </div>
      <div class="sidebar-nav">
        <a href="/dashboard" class="nav-item"><i class="fa-solid fa-chart-pie"></i> Overview</a>
        <a href="/guilds" class="nav-item active"><i class="fa-solid fa-server"></i> Servers</a>
        <a href="/library" class="nav-item"><i class="fa-solid fa-book-open"></i> Song Library</a>
        <a href="/logs" class="nav-item"><i class="fa-solid fa-terminal"></i> Live Logs</a>
      </div>
    </aside>
    <main class="main-content">
      <div class="page-header">
        <h1>Connected Servers</h1>
        <p>Manage the Discord servers where your bot is currently active.</p>
      </div>
      <div class="glass-card">
        <h3><i class="fa-solid fa-server" style="color: var(--accent-primary);"></i> Active Guilds</h3>
        <div class="table-wrapper">
          <table>
            <thead>
              <tr>
                <th>Server Name</th>
                <th>Members</th>
                <th>Voice Region</th>
                <th style="text-align: right;">Action</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td class="guild-cell">
                  <div class="guild-icon"><i class="fa-solid fa-shield-halved"></i></div>
                  <span style="font-weight: 600;">My Discord Server</span>
                </td>
                <td>5 Users</td>
                <td>Global Node</td>
                <td style="text-align: right;">
                  <button class="btn-primary" style="padding: 6px 14px; font-size: 13px;" onclick="alert('Connected!')">Configure</button>
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </main>
  </div>
</body>
</html>