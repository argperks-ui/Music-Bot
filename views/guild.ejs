<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Git Music — <%= title %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <div class="layout">
    <nav class="sidebar">
      <div class="sidebar-brand">
        <div class="brand-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="28" height="28">
            <path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/>
          </svg>
        </div>
        <span class="brand-text">Git Music</span>
      </div>

      <div class="sidebar-user">
        <% if (user.avatar) { %>
          <img class="avatar" src="https://cdn.discordapp.com/avatars/<%= user.id %>/<%= user.avatar %>.png?size=64" alt="">
        <% } else { %>
          <div class="avatar avatar-placeholder"><%= (user.global_name || user.username).charAt(0) %></div>
        <% } %>
        <div class="user-info">
          <span class="user-name"><%= user.global_name || user.username %></span>
          <span class="user-tag"><%= '#' + user.discriminator %></span>
        </div>
      </div>

      <div class="sidebar-nav">
        <a href="/dashboard" class="nav-item">Overview</a>
        <a href="/guilds" class="nav-item active">Servers</a>
        <a href="/analytics" class="nav-item">Analytics</a>
        <a href="/logs" class="nav-item">Logs</a>
      </div>

      <div class="sidebar-footer">
        <a href="/logout" class="nav-item logout">Logout</a>
      </div>
    </nav>

    <main class="main-content">
      <header class="page-header">
        <div class="breadcrumb">
          <a href="/guilds">Servers</a>
          <span class="breadcrumb-sep">/</span>
          <span><%= guild ? guild.name : 'Unknown' %></span>
        </div>
        <div class="header-meta">
          <% if (guild) { %>
            <span class="guild-id">ID: <%= guild.id %></span>
          <% } %>
        </div>
      </header>

      <% if (error) { %>
        <div class="alert alert-error">
          <strong>Error loading server:</strong> <%= error %>
        </div>
      <% } %>

      <% if (saved) { %>
        <div class="alert alert-success">
          Settings saved successfully!
        </div>
      <% } %>

      <% if (guild) { %>
      <!-- Guild Profile -->
      <div class="guild-profile">
        <div class="guild-icon-wrapper guild-icon-lg">
          <% if (guild.icon) { %>
            <img src="https://cdn.discordapp.com/icons/<%= guild.id %>/<%= guild.icon %>.png?size=256" alt="" class="guild-icon">
          <% } else { %>
            <div class="guild-icon guild-icon-placeholder guild-icon-placeholder-lg"><%= guild.name.charAt(0) %></div>
          <% } %>
        </div>
        <div class="guild-profile-info">
          <h2><%= guild.name %></h2>
          <div class="guild-profile-stats">
            <span><strong><%= guild.approximate_member_count || '?' %></strong> members</span>
            <span><strong><%= guild.approximate_presence_count || '?' %></strong> online</span>
            <span><strong><%= guild.owner_id === bot.id ? 'Yes' : 'No' %></strong> bot is owner</span>
          </div>
        </div>
      </div>

      <!-- Settings Form -->
      <div class="card">
        <h3>Server Settings</h3>
        <form action="/guild/<%= guild.id %>/settings" method="POST" class="settings-form">
          <div class="form-row">
            <div class="form-group">
              <label for="prefix">Command Prefix</label>
              <input type="text" id="prefix" name="prefix" value="<%= settings.prefix || '!' %>" maxlength="4" class="form-input form-input-short" placeholder="!">
            </div>

            <div class="form-group">
              <label for="volume">Default Volume (0–100)</label>
              <input type="number" id="volume" name="volume" min="0" max="100" value="<%= settings.volume || 100 %>" class="form-input form-input-short">
              <input type="range" min="0" max="100" value="<%= settings.volume || 100 %>" class="volume-slider" oninput="document.getElementById('volume').value=this.value">
            </div>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label for="dj_role">DJ Role ID</label>
              <input type="text" id="dj_role" name="dj_role" value="<%= settings.dj_role || '' %>" class="form-input" placeholder="Role ID (leave blank to disable)">
            </div>

            <div class="form-group">
              <label for="announce_channel">Announcement Channel ID</label>
              <input type="text" id="announce_channel" name="announce_channel" value="<%= settings.announce_channel || '' %>" class="form-input" placeholder="Channel ID (leave blank to disable)">
            </div>
          </div>

          <div class="form-row">
            <div class="form-group form-group-inline">
              <label class="checkbox-label">
                <input type="checkbox" name="mode_24_7" <%= settings.mode_24_7 ? 'checked' : '' %>>
                <span>24/7 Mode (stays in voice channel)</span>
              </label>
            </div>

            <div class="form-group form-group-inline">
              <label class="checkbox-label">
                <input type="checkbox" name="allow_nsfw" <%= settings.allow_nsfw ? 'checked' : '' %>>
                <span>Allow NSFW Content</span>
              </label>
            </div>
          </div>

          <div class="form-actions">
            <button type="submit" class="btn btn-accent">Save Settings</button>
          </div>
        </form>
      </div>

      <!-- Danger Zone -->
      <div class="card card-danger">
        <h3>Danger Zone</h3>
        <p>Leaving a server removes Git Music from it. This action cannot be undone.</p>
        <form action="/guild/<%= guild.id %>/leave" method="POST" onsubmit="return confirm('Are you sure you want to leave <%= guild.name %>?');">
          <button type="submit" class="btn btn-danger">Leave Server</button>
        </form>
      </div>

      <% } %>
    </main>
  </div>
</body>
</html>