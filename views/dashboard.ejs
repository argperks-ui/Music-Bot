<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Cyber Dashboard - Git Music</title>
  <link rel="stylesheet" href="/style.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body>
  <div class="app-layout">
    <aside class="sidebar">
      <div class="sidebar-brand">
        <div class="sidebar-brand-icon"><i class="fa-solid fa-compact-disc fa-spin"></i></div>
        <div class="sidebar-brand-text"><h2>Git Music</h2><span>v2.0 Cyber Engine</span></div>
      </div>
      <div class="sidebar-nav">
        <a href="/dashboard" class="nav-item active"><i class="fa-solid fa-chart-pie"></i> Overview</a>
        <a href="/guilds" class="nav-item"><i class="fa-solid fa-server"></i> Servers</a>
        <a href="/library" class="nav-item"><i class="fa-solid fa-book-open"></i> Song Library</a>
        <a href="/logs" class="nav-item"><i class="fa-solid fa-terminal"></i> Live Logs</a>
      </div>
    </aside>

    <main class="main-content">
      <div class="page-header">
        <h1>Command Center</h1>
        <p>Live remote control and audio DSP monitoring across active Discord servers.</p>
      </div>

      <% if (typeof error !== 'undefined' && error) { %>
        <div class="glass-card" style="border-left: 4px solid #ef4444;">
          <h3 style="color: #ef4444;"><i class="fa-solid fa-circle-exclamation"></i> Sync Warning</h3>
          <p><%= error %></p>
        </div>
      <% } else if (botState && botState.guilds) { %>
        <% Object.keys(botState.guilds).forEach(guildId => { %>
          <% const g = botState.guilds[guildId]; %>
          <div class="glass-card" style="margin-bottom: 24px;">
            <div style="display: flex; justify-content: space-between; align-items: center;">
              <h3><i class="fa-solid fa-server" style="color: var(--accent-primary);"></i> <%= g.guild_name %></h3>
              <span class="badge" style="background: rgba(139, 92, 246, 0.2); padding: 4px 12px; border-radius: 12px; font-size: 12px;">Active Filter: <%= g.filter.toUpperCase() %></span>
            </div>

            <div style="margin: 20px 0; background: rgba(0,0,0,0.3); padding: 16px; border-radius: 12px; display: flex; gap: 20px; align-items: center;">
              <img src="<%= g.current ? g.current.thumbnail : 'https://images.unsplash.com/photo-1511671782779-c97d3d27a1d4' %>" style="width: 90px; height: 90px; border-radius: 8px; object-fit: cover;">
              <div>
                <h4 style="margin: 0 0 6px 0;"><%= g.current ? g.current.title : 'No Track Currently Playing' %></h4>
                <p style="margin: 0; color: #a78bfa; font-size: 14px;"><%= g.current ? g.current.uploader : 'Use /play on Discord to queue audio' %></p>
              </div>
            </div>

            <!-- Remote Buttons -->
            <div style="display: flex; gap: 10px; flex-wrap: wrap;">
              <button class="btn-primary" onclick="sendControl('<%= guildId %>', 'pause_resume')"><i class="fa-solid fa-play-pause"></i> Pause/Resume</button>
              <button class="btn-primary" style="background: #4b5563;" onclick="sendControl('<%= guildId %>', 'skip')"><i class="fa-solid fa-forward"></i> Skip</button>
              <button class="btn-primary" style="background: #059669;" onclick="sendFilter('<%= guildId %>', 'bassboost')"><i class="fa-solid fa-sliders"></i> Bass Boost</button>
              <button class="btn-primary" style="background: #7c3aed;" onclick="sendFilter('<%= guildId %>', 'nightcore')"><i class="fa-solid fa-bolt"></i> Nightcore</button>
              <button class="btn-primary" style="background: #dc2626;" onclick="sendFilter('<%= guildId %>', 'off')"><i class="fa-solid fa-ban"></i> Reset DSP</button>
            </div>
          </div>
        <% }) %>
      <% } %>
    </main>
  </div>

  <script>
    async function sendControl(guildId, action) {
      await fetch('/api/control', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ guild_id: guildId, action })
      });
      location.reload();
    }
    async function sendFilter(guildId, filterValue) {
      await fetch('/api/control', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ guild_id: guildId, action: 'filter', value: filterValue })
      });
      location.reload();
    }
  </script>
</body>
</html>