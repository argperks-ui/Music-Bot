<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard - Git Music</title>
  <link rel="stylesheet" href="/style.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body>

  <div class="app-layout">
    <!-- Sidebar -->
    <aside class="sidebar">
      <div class="sidebar-brand">
        <div class="sidebar-brand-icon">
          <i class="fa-solid fa-music"></i>
        </div>
        <div class="sidebar-brand-text">
          <h2>Git Music</h2>
          <span>Dashboard</span>
        </div>
      </div>
      
      <div class="sidebar-nav">
        <a href="/dashboard" class="nav-item active">
          <i class="fa-solid fa-chart-pie"></i> Overview
        </a>
        <a href="/guilds" class="nav-item">
          <i class="fa-solid fa-server"></i> Servers
        </a>
        <a href="/library" class="nav-item">
          <i class="fa-solid fa-book-open"></i> Song Library
        </a>
        <a href="/logs" class="nav-item">
          <i class="fa-solid fa-terminal"></i> Live Logs
        </a>
      </div>

      <% if (typeof user !== 'undefined' && user) { %>
      <div class="sidebar-footer">
        <div class="sidebar-user">
          <img src="https://cdn.discordapp.com/avatars/<%= user.id %>/<%= user.avatar %>.png" alt="Avatar">
          <div class="sidebar-user-info">
            <div class="name"><%= user.global_name || user.username %></div>
            <div class="status">Online</div>
          </div>
          <a href="/logout" style="color: var(--danger);"><i class="fa-solid fa-right-from-bracket"></i></a>
        </div>
      </div>
      <% } %>
    </aside>

    <!-- Main Content -->
    <main class="main-content">
      
      <div class="page-header">
        <div>
          <h1>Dashboard Overview</h1>
          <p>Manage audio playback and bot voice states in real time.</p>
        </div>
        <div class="header-time">
          <i class="fa-solid fa-circle-dot" style="color: var(--success);"></i> Bot Online
        </div>
      </div>

      <!-- Enhanced Live VC Music HUD -->
      <div class="vc-hud-bar" id="vcHud">
        <div class="vc-info">
          <div class="vc-pulse" id="vcPulse"></div>
          <div class="vc-song-details">
            <h4 id="hudSongTitle"><%= typeof player !== 'undefined' && player.currentSong ? player.currentSong.title : 'No track playing' %></h4>
            <p id="hudChannelInfo">
              <i class="fa-solid fa-volume-high" style="color: var(--accent-secondary);"></i> 
              <span id="hudChannel"><%= typeof player !== 'undefined' && player.channelName ? player.channelName : 'Disconnected from Voice' %></span>
            </p>
          </div>
        </div>
        <div class="vc-controls">
          <button class="btn-control" onclick="sendPlayerAction('pause')" title="Pause"><i class="fa-solid fa-pause"></i></button>
          <button class="btn-control" onclick="sendPlayerAction('play')" title="Resume"><i class="fa-solid fa-play"></i></button>
          <button class="btn-control" onclick="sendPlayerAction('skip')" title="Skip"><i class="fa-solid fa-forward-step"></i></button>
          <button class="btn-control" onclick="sendPlayerAction('stop')" title="Stop & Disconnect" style="color: var(--danger);"><i class="fa-solid fa-stop"></i></button>
        </div>
      </div>

      <!-- Quick Voice Action Cards -->
      <div class="dashboard-actions-grid">
        <button class="btn-action-card" onclick="joinMyVc()">
          <div class="btn-action-icon" style="background: rgba(34, 197, 94, 0.15); color: var(--success);">
            <i class="fa-solid fa-headset"></i>
          </div>
          <div class="btn-action-info">
            <h4>Join My VC</h4>
            <p>Connect bot to your channel</p>
          </div>
        </button>

        <button class="btn-action-card" onclick="sendPlayerAction('shuffle')">
          <div class="btn-action-icon" style="background: rgba(6, 182, 212, 0.15); color: var(--accent-secondary);">
            <i class="fa-solid fa-shuffle"></i>
          </div>
          <div class="btn-action-info">
            <h4>Shuffle Queue</h4>
            <p>Randomize current playlist</p>
          </div>
        </button>

        <button class="btn-action-card" onclick="sendPlayerAction('clear')">
          <div class="btn-action-icon" style="background: rgba(239, 68, 68, 0.15); color: var(--danger);">
            <i class="fa-solid fa-trash-can"></i>
          </div>
          <div class="btn-action-info">
            <h4>Clear Queue</h4>
            <p>Remove upcoming tracks</p>
          </div>
        </button>

        <button class="btn-action-card" onclick="window.location.href='/library'">
          <div class="btn-action-icon">
            <i class="fa-solid fa-book-open"></i>
          </div>
          <div class="btn-action-info">
            <h4>Song Library</h4>
            <p>Browse saved audio tracks</p>
          </div>
        </button>
      </div>

      <!-- Stat Cards Grid -->
      <div class="stats-grid">
        <div class="stat-card">
          <div class="stat-card-header">
            <span class="stat-card-label">Servers</span>
            <div class="stat-card-icon purple"><i class="fa-solid fa-server"></i></div>
          </div>
          <div class="stat-card-value">1</div>
          <div class="stat-card-change up"><i class="fa-solid fa-arrow-trend-up"></i> Active node</div>
        </div>

        <div class="stat-card">
          <div class="stat-card-header">
            <span class="stat-card-label">Total Users</span>
            <div class="stat-card-icon cyan"><i class="fa-solid fa-users"></i></div>
          </div>
          <div class="stat-card-value">5</div>
          <div class="stat-card-change up"><i class="fa-solid fa-arrow-trend-up"></i> Reach</div>
        </div>

        <div class="stat-card">
          <div class="stat-card-header">
            <span class="stat-card-label">Voice Connections</span>
            <div class="stat-card-icon green"><i class="fa-solid fa-microphone"></i></div>
          </div>
          <div class="stat-card-value" id="listenerCount">0</div>
          <div class="stat-card-change">Active listeners</div>
        </div>

        <div class="stat-card">
          <div class="stat-card-header">
            <span class="stat-card-label">API Ping</span>
            <div class="stat-card-icon orange"><i class="fa-solid fa-bolt"></i></div>
          </div>
          <div class="stat-card-value">14ms</div>
          <div class="stat-card-change up"><i class="fa-solid fa-circle-check"></i> Stable</div>
        </div>
      </div>

      <!-- Bot Specs Panel -->
      <div class="glass-card">
        <h3><i class="fa-solid fa-robot" style="color: var(--accent-primary);"></i> Bot System Specs</h3>
        <div class="status-grid">
          <div class="status-item">
            <span class="status-item-label">Node Version</span>
            <span class="status-item-value">v20.20.2</span>
          </div>
          <div class="status-item">
            <span class="status-item-label">Memory Usage</span>
            <span class="status-item-value">12.53 MB</span>
          </div>
          <div class="status-item">
            <span class="status-item-label">Uptime</span>
            <span class="status-item-value">1m 40s</span>
          </div>
          <div class="status-item">
            <span class="status-item-label">Status</span>
            <span class="status-item-value"><span class="status-dot online"></span>Operational</span>
          </div>
        </div>
      </div>

    </main>
  </div>

  <script src="/socket.io/socket.io.js"></script>
  <script>
    const socket = io();
    
    socket.on('player_update', (player) => {
      document.getElementById('hudSongTitle').textContent = player.currentSong ? player.currentSong.title : 'No track playing';
      document.getElementById('hudChannel').textContent = player.channelName || 'Disconnected from Voice';
      if (document.getElementById('listenerCount')) {
        document.getElementById('listenerCount').textContent = player.listeners || 0;
      }
    });

    function sendPlayerAction(action) {
      fetch('/api/player/control', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ action })
      }).then(res => res.json()).then(data => {
        if (!data.success && data.error) alert(data.error);
      }).catch(err => console.error(err));
    }

    function joinMyVc() {
      fetch('/api/player/join', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' }
      }).then(res => res.json()).then(data => {
        if (data.success) {
          alert('Successfully joined your voice channel!');
        } else {
          alert(data.error || 'Make sure you are connected to a voice channel in Discord first!');
        }
      }).catch(err => {
        alert('Failed to connect to voice channel.');
      });
    }
  </script>
</body>
</html>